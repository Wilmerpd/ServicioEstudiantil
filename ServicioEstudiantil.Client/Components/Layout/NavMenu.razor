<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <span class="brand-icon">🏫</span> Servicio Estudiantil
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

        <!-- El inicio siempre es visible -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="nav-emoji">🏠</span> Inicio
            </NavLink>
        </div>

        <!-- Validación de Seguridad -->
        <AuthorizeView>
            <Authorized>
                <div class="nav-section-title">Gestión académica</div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="estudiantes">
                        <span class="nav-emoji">🧑‍🎓</span> Estudiantes
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="profesores">
                        <span class="nav-emoji">👨‍🏫</span> Profesores
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="asignaturas">
                        <span class="nav-emoji">📚</span> Asignaturas
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="horarios">
                        <span class="nav-emoji">🕒</span> Horarios
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="titulaciones">
                        <span class="nav-emoji">🎓</span> Titulaciones
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="matriculas">
                        <span class="nav-emoji">📝</span> Matrículas
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="calificaciones">
                        <span class="nav-emoji">💯</span> Calificaciones
                    </NavLink>
                </div>

                <!-- BOTÓN DE CERRAR SESIÓN -->
                <div class="nav-item px-3 mt-4">
                    <button class="nav-link btn btn-link text-danger w-100 text-start" @onclick="CerrarSesion">
                        <span class="nav-emoji">🚪</span> Cerrar Sesión
                    </button>
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="nav-section-title">Acceso</div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="nav-emoji">🔐</span> Iniciar Sesión
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private async Task CerrarSesion()
    {
        // 1. Borramos el token del navegador
        await JS.InvokeVoidAsync("localStorage.removeItem", "authToken");

        // 2. Le avisamos a Blazor que ya no eres administrador
        var customAuth = (ServicioEstudiantil.Client.Auth.CustomAuthStateProvider)AuthStateProvider;
        customAuth.NotificarUsuarioDeslogueado();

        // 3. Te mandamos a la pantalla de inicio
        NavigationManager.NavigateTo("/", forceLoad: true);
    }
}