@page "/estudiantes"
@rendermode InteractiveServer
@inject IEstudianteService EstudianteService
@using ServicioEstudiantil.Client.Contracts
@using ServicioEstudiantil.Core.Features.Estudiantes.Queries.GetEstudiantesList
@using ServicioEstudiantil.Core.Features.Estudiantes.Commands.CreateEstudiante
@using ServicioEstudiantil.Core.Features.Estudiantes.Commands.UpdateEstudiante

<!-- Encabezado unificado -->
<div class="mb-4">
    <h3 class="mb-1">Estudiantes</h3>
    <p class="text-muted">Estudiantes matriculados en el sistema.</p>
</div>

<!-- Formulario de Registro / Edición -->
<div class="card mb-4 p-3 shadow-sm border-0">
    <h5 class="mb-3">@(editandoId == 0 ? "Registrar Nuevo Estudiante" : $"Editando Estudiante ID: {editandoId}")</h5>
    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label">Matrícula</label>
            <input class="form-control" placeholder="Ej: 2026-0005" @bind="nuevoMatricula" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Nombres</label>
            <input class="form-control" placeholder="Nombres" @bind="nuevoNombres" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Apellidos</label>
            <input class="form-control" placeholder="Apellidos" @bind="nuevoApellidos" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Correo Institucional</label>
            <input class="form-control" placeholder="correo@unicda.edu.do" @bind="nuevoCorreo" />
        </div>
    </div>
    <div class="mt-4 text-end">
        @if (editandoId != 0)
        {
            <button type="button" class="btn btn-secondary me-2" @onclick="CancelarEdicion">Cancelar</button>
        }
        <button type="button" class="btn btn-primary px-4" @onclick="GuardarEstudiante">
            @(editandoId == 0 ? "+ Nuevo estudiante" : "Actualizar Cambios")
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(mensajeFeedback))
{
    <div class="alert alert-info shadow-sm">@mensajeFeedback</div>
}

@if (estudiantes == null)
{
    <p><em>Cargando estudiantes desde la base de datos...</em></p>
}
else if (!estudiantes.Any())
{
    <p class="text-muted">No hay estudiantes registrados en el sistema.</p>
}
else
{
    <div class="table-responsive bg-white shadow-sm rounded-3">
        <table class="table table-hover align-middle mb-0">
            <thead class="text-uppercase" style="font-size: 0.85rem; font-weight: 600;">
                <tr>
                    <th class="ps-4">ID</th>
                    <th>Matrícula</th>
                    <th>Nombre Completo</th>
                    <th>Correo Institucional</th>
                    <th class="text-end pe-4" style="width: 200px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var est in estudiantes)
                {
                    <tr>
                        <td class="ps-4">@est.Id</td>
                        <td>@est.Matricula</td>
                        <td>
                            <div class="d-flex align-items-center">
                                <!-- Círculo con iniciales -->
                                <span class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-3 fw-bold" style="width: 38px; height: 38px; font-size: 0.9rem;">
                                    @ObtenerIniciales(est.NombreCompleto)
                                </span>
                                <span class="fw-medium">@est.NombreCompleto</span>
                            </div>
                        </td>
                        <td>@est.Correo</td>
                        <td class="text-end pe-4">
                            <!-- Contenedor Flex para forzar botones lado a lado -->
                            <div class="d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-sm btn-outline-primary px-3" @onclick="() => PrepararEdicion(est)">Editar</button>
                                <button type="button" class="btn btn-sm btn-outline-danger px-3" @onclick="() => Eliminar(est.Id)">Eliminar</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<EstudianteDto>? estudiantes;

    private int editandoId = 0;
    private string nuevoMatricula = string.Empty;
    private string nuevoNombres = string.Empty;
    private string nuevoApellidos = string.Empty;
    private string nuevoCorreo = string.Empty;
    private string mensajeFeedback = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarEstudiantes();
    }

    private async Task CargarEstudiantes()
    {
        estudiantes = await EstudianteService.ObtenerEstudiantesAsync();
    }

    private async Task GuardarEstudiante()
    {
        if (string.IsNullOrWhiteSpace(nuevoMatricula))
        {
            mensajeFeedback = "La matrícula es obligatoria.";
            return;
        }

        bool exito = false;

        if (editandoId == 0)
        {
            var command = new CreateEstudianteCommand(nuevoMatricula, nuevoNombres, nuevoApellidos, nuevoCorreo, 1);
            exito = await EstudianteService.CrearEstudianteAsync(command);
            mensajeFeedback = exito ? "Estudiante registrado correctamente." : "Error al registrar el estudiante.";
        }
        else
        {
            var command = new UpdateEstudianteCommand(editandoId, nuevoMatricula, nuevoNombres, nuevoApellidos, nuevoCorreo, 1);
            exito = await EstudianteService.ActualizarEstudianteAsync(editandoId, command);
            mensajeFeedback = exito ? "Estudiante actualizado correctamente." : "Error al actualizar el estudiante.";
        }

        if (exito)
        {
            LimpiarFormulario();
            await CargarEstudiantes();
        }
    }

    private void PrepararEdicion(EstudianteDto est)
    {
        editandoId = est.Id;
        nuevoMatricula = est.Matricula;

        var partes = est.NombreCompleto.Split(' ', 2);
        nuevoNombres = partes.Length > 0 ? partes[0] : string.Empty;
        nuevoApellidos = partes.Length > 1 ? partes[1] : string.Empty;
        nuevoCorreo = est.Correo;
        mensajeFeedback = $"Editando al estudiante con ID: {est.Id}";
    }

    private void CancelarEdicion()
    {
        LimpiarFormulario();
        mensajeFeedback = "Edición cancelada.";
    }

    private void LimpiarFormulario()
    {
        editandoId = 0;
        nuevoMatricula = string.Empty;
        nuevoNombres = string.Empty;
        nuevoApellidos = string.Empty;
        nuevoCorreo = string.Empty;
    }

    private async Task Eliminar(int id)
    {
        var exito = await EstudianteService.EliminarEstudianteAsync(id);
        if (exito)
        {
            mensajeFeedback = "Estudiante eliminado correctamente.";
            await CargarEstudiantes();
        }
        else
        {
            mensajeFeedback = "Error al intentar eliminar el estudiante.";
        }
    }

    // Método auxiliar para obtener las iniciales del nombre
    private string ObtenerIniciales(string nombreCompleto)
    {
        if (string.IsNullOrWhiteSpace(nombreCompleto)) return "";

        var partes = nombreCompleto.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length >= 2) return $"{partes[0][0]}{partes[1][0]}".ToUpper();
        if (partes.Length == 1) return $"{partes[0][0]}".ToUpper();

        return "";
    }
}