@page "/profesores"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IProfesorService ProfesorService
@using ServicioEstudiantil.Client.Contracts

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3>Profesores</h3>
        <p class="text-muted">Cuerpo docente registrado en el sistema.</p>
    </div>
</div>

<div class="card mb-4 p-3 shadow-sm">
    <h5>@(editandoId == 0 ? "Registrar Nuevo Profesor" : "Editar Profesor")</h5>
    <div class="row g-3">
        <div class="col-md-2">
            <label class="form-label">Identificación</label>
            <input class="form-control" placeholder="Ej: 001-123" @bind="nuevaIdentificacion" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Nombres</label>
            <input class="form-control" @bind="nuevoNombre" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Apellidos</label>
            <input class="form-control" @bind="nuevoApellido" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Correo de Contacto</label>
            <input class="form-control" type="email" @bind="nuevoCorreo" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Departamento</label>
            <input class="form-control" placeholder="Ej: Ingeniería de Software" @bind="nuevoDepartamento" />
        </div>
        <div class="col-12 text-end mt-3">
            <button class="btn btn-primary" @onclick="Guardar">
                @(editandoId == 0 ? "+ Nuevo profesor" : "Guardar Cambios")
            </button>
        </div>
    </div>
</div>

@if (profesores == null)
{
    <p><em>Cargando profesores...</em></p>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">NOMBRE COMPLETO</th>
                        <th>IDENTIFICACIÓN</th>
                        <th>CORREO DE CONTACTO</th>
                        <th>DEPARTAMENTO</th>
                        <th class="text-end pe-4">ACCIONES</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in profesores)
                    {
                        <tr>
                            <td class="ps-4 d-flex align-items-center mt-2 mb-2">
                                <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 35px; height: 35px; font-weight: bold; font-size: 14px;">
                                    @ObtenerIniciales(p.NombreCompleto)
                                </div>
                                <span>@p.NombreCompleto</span>
                            </td>
                            <td>@p.Identificacion</td>
                            <td>@p.Correo</td>
                            <td>
                                <span class="badge bg-light text-primary border border-primary-subtle px-2 py-1">@p.Departamento</span>
                            </td>
                            <td class="text-end pe-4">
                                <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => PrepararEdicion(p)">Editar</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(p.Id)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<ServicioEstudiantil.Core.DTOs.ProfesorDTO>? profesores;
    private int editandoId = 0;

    // Variables para el formulario
    private string nuevaIdentificacion = string.Empty;
    private string nuevoNombre = string.Empty;
    private string nuevoApellido = string.Empty;
    private string nuevoCorreo = string.Empty;
    private string nuevoDepartamento = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        profesores = await ProfesorService.ObtenerProfesoresAsync();
    }

    private async Task Guardar()
    {
        // Validamos que por lo menos la identificación y nombres no estén vacíos
        if (string.IsNullOrWhiteSpace(nuevaIdentificacion) || string.IsNullOrWhiteSpace(nuevoNombre)) return;

        var inputDto = new ServicioEstudiantil.Core.DTOs.ProfesorInputDTO
            {
                Id = editandoId,
                Identificacion = nuevaIdentificacion,
                Nombres = nuevoNombre,
                Apellidos = nuevoApellido,
                Correo = nuevoCorreo,
                Departamento = nuevoDepartamento
            };

        bool exito;
        if (editandoId == 0)
        {
            exito = await ProfesorService.CrearProfesorAsync(inputDto);
        }
        else
        {
            exito = await ProfesorService.ActualizarProfesorAsync(inputDto);
        }

        if (exito)
        {
            LimpiarFormulario();
            await CargarDatos();
        }
    }

    private void PrepararEdicion(ServicioEstudiantil.Core.DTOs.ProfesorDTO p)
    {
        editandoId = p.Id;
        nuevaIdentificacion = p.Identificacion;

        var partes = p.NombreCompleto.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
        nuevoNombre = partes.Length > 0 ? partes[0] : "";
        nuevoApellido = partes.Length > 1 ? partes[1] : "";

        nuevoCorreo = p.Correo;
        nuevoDepartamento = p.Departamento;
    }

    private async Task Eliminar(int id)
    {
        await ProfesorService.EliminarProfesorAsync(id);
        await CargarDatos();
    }

    private void LimpiarFormulario()
    {
        editandoId = 0;
        nuevaIdentificacion = ""; nuevoNombre = ""; nuevoApellido = ""; nuevoCorreo = ""; nuevoDepartamento = "";
    }

    private string ObtenerIniciales(string nombreCompleto)
    {
        if (string.IsNullOrWhiteSpace(nombreCompleto)) return "";
        var partes = nombreCompleto.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var ini1 = partes.Length > 0 ? partes[0].Substring(0, 1).ToUpper() : "";
        var ini2 = partes.Length > 1 ? partes[1].Substring(0, 1).ToUpper() : "";
        return $"{ini1}{ini2}";
    }
}