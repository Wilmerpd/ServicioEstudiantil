@page "/asignaturas"
@rendermode InteractiveServer
@inject IAsignaturaService AsignaturaService
@using ServicioEstudiantil.Client.Contracts
@using ServicioEstudiantil.Core.DTOs
@using ServicioEstudiantil.Core.Features.Asignaturas.Commands.CreateAsignatura
@using ServicioEstudiantil.Core.Features.Asignaturas.Commands.UpdateAsignatura


<h3>Gestión de Asignaturas</h3>

<div class="card mb-4 p-3 shadow-sm">
    <h5>@(editandoId == 0 ? "Registrar Nueva Asignatura" : $"Editando Asignatura ID: {editandoId}")</h5>
    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label">Código</label>
            <input class="form-control" placeholder="Ej: ISW-101" @bind="nuevoCodigo" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Nombre</label>
            <input class="form-control" placeholder="Nombre de la asignatura" @bind="nuevoNombre" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Créditos</label>
            <input type="number" class="form-control" @bind="nuevoCreditos" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Departamento</label>
            <input class="form-control" placeholder="Departamento" @bind="nuevoDepartamento" />
        </div>
    </div>
    <div class="mt-3">
        <button type="button" class="btn btn-primary" @onclick="GuardarAsignatura">
            @(editandoId == 0 ? "Guardar Asignatura" : "Actualizar Cambios")
        </button>
        @if (editandoId != 0)
        {
            <button type="button" class="btn btn-secondary ms-2" @onclick="CancelarEdicion">Cancelar</button>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(mensajeFeedback))
{
    <div class="alert alert-info">@mensajeFeedback</div>
}

@if (asignaturas == null)
{
    <p><em>Cargando asignaturas desde la base de datos...</em></p>
}
else if (!asignaturas.Any())
{
    <p>No hay asignaturas registradas en el sistema.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Código</th>
                <th>Nombre</th>
                <th>Créditos</th>
                <th>Departamento</th>
                <th style="width: 180px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var asig in asignaturas)
            {
                <tr>
                    <td>@asig.Id</td>
                    <td>@asig.Codigo</td>
                    <td>@asig.Nombre</td>
                    <td>@asig.Creditos</td>
                    <td>@asig.Departamento</td>
                    <td>
                        <button type="button" class="btn btn-warning btn-sm me-1" @onclick="() => PrepararEdicion(asig)">Editar</button>
                        <button type="button" class="btn btn-danger btn-sm" @onclick="() => Eliminar(asig.Id)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<AsignaturaDTO>? asignaturas;

    private int editandoId = 0;
    private string nuevoCodigo = string.Empty;
    private string nuevoNombre = string.Empty;
    private int nuevoCreditos = 4;
    private string nuevoDepartamento = string.Empty;
    private string mensajeFeedback = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsignaturas();
    }

    private async Task CargarAsignaturas()
    {
        asignaturas = await AsignaturaService.ObtenerAsignaturasAsync();
    }

    private async Task GuardarAsignatura()
    {
        if (string.IsNullOrWhiteSpace(nuevoCodigo) || string.IsNullOrWhiteSpace(nuevoNombre))
        {
            mensajeFeedback = "El código y el nombre son obligatorios.";
            return;
        }

        bool exito = false;

        if (editandoId == 0)
        {
            var command = new CreateAsignaturaCommand(nuevoCodigo, nuevoNombre, nuevoCreditos, nuevoDepartamento);
            exito = await AsignaturaService.CrearAsignaturaAsync(command);
            mensajeFeedback = exito ? "Asignatura registrada correctamente." : "Error al registrar la asignatura.";
        }
        else
        {
            var command = new UpdateAsignaturaCommand(editandoId, nuevoCodigo, nuevoNombre, nuevoCreditos, nuevoDepartamento);
            exito = await AsignaturaService.ActualizarAsignaturaAsync(editandoId, command);
            mensajeFeedback = exito ? "Asignatura actualizada correctamente." : "Error al actualizar la asignatura.";
        }

        if (exito)
        {
            LimpiarFormulario();
            await CargarAsignaturas();
        }
    }

    private void PrepararEdicion(AsignaturaDTO asig)
    {
        editandoId = asig.Id;
        nuevoCodigo = asig.Codigo;
        nuevoNombre = asig.Nombre;
        nuevoCreditos = asig.Creditos;
        nuevoDepartamento = asig.Departamento;
        mensajeFeedback = $"Editando la asignatura con ID: {asig.Id}";
    }

    private void CancelarEdicion()
    {
        LimpiarFormulario();
        mensajeFeedback = "Edición cancelada.";
    }

    private void LimpiarFormulario()
    {
        editandoId = 0;
        nuevoCodigo = string.Empty;
        nuevoNombre = string.Empty;
        nuevoCreditos = 4;
        nuevoDepartamento = string.Empty;
    }

    private async Task Eliminar(int id)
    {
        var exito = await AsignaturaService.EliminarAsignaturaAsync(id);
        if (exito)
        {
            mensajeFeedback = "Asignatura eliminada correctamente.";
            await CargarAsignaturas();
        }
        else
        {
            mensajeFeedback = "Error al intentar eliminar la asignatura.";
        }
    }
}