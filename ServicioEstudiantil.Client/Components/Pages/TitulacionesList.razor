@page "/titulaciones"
@rendermode InteractiveServer
@inject ITitulacionService TitulacionService
@using ServicioEstudiantil.Client.Contracts
@using ServicioEstudiantil.Core.DTOs

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3>Titulaciones</h3>
        <p class="text-muted">Programas académicos que ofrece la institución.</p>
    </div>
</div>

<div class="card mb-4 p-3 shadow-sm">
    <h5>@(editandoId == 0 ? "Nueva Titulación" : "Editar Titulación")</h5>
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Código</label>
            <input class="form-control" placeholder="Ej: UNICDA-2026" @bind="nuevoCodigo" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Nombre del Programa</label>
            <input class="form-control" placeholder="Ej: Ingeniería de Software" @bind="nuevoNombre" />
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="button" class="btn btn-primary w-100" @onclick="Guardar">
                @(editandoId == 0 ? "Guardar" : "Actualizar")
            </button>
        </div>
    </div>
</div>

@if (titulaciones == null)
{
    <p><em>Cargando titulaciones...</em></p>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">CÓDIGO</th>
                        <th>NOMBRE</th>
                        <th class="text-end pe-4">ACCIONES</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in titulaciones)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle px-2 py-1">@t.Codigo</span>
                            </td>
                            <td>@t.Nombre</td>
                            <td class="text-end pe-4">
                                <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => PrepararEdicion(t)">Editar</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(t.Id)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<TitulacionDTO>? titulaciones;
    private int editandoId = 0;
    private string nuevoCodigo = string.Empty;
    private string nuevoNombre = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        titulaciones = await TitulacionService.ObtenerTitulacionesAsync();
    }

    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(nuevoCodigo) || string.IsNullOrWhiteSpace(nuevoNombre)) return;

        // Creamos el DTO que espera tu servicio
        var inputDto = new TitulacionInputDTO
            {
                Id = editandoId,
                Codigo = nuevoCodigo,
                Nombre = nuevoNombre
            };

        bool exito;
        if (editandoId == 0)
        {
            exito = await TitulacionService.CrearTitulacionAsync(inputDto);
        }
        else
        {
            // Llamamos a actualizar (tu servicio solo pide el DTO, no el id suelto)
            exito = await TitulacionService.ActualizarTitulacionAsync(inputDto);
        }

        if (exito)
        {
            editandoId = 0;
            nuevoCodigo = "";
            nuevoNombre = "";
            await CargarDatos();
        }
    }

    private void PrepararEdicion(TitulacionDTO t)
    {
        editandoId = t.Id;
        nuevoCodigo = t.Codigo;
        nuevoNombre = t.Nombre;
    }

    private async Task Eliminar(int id)
    {
        await TitulacionService.EliminarTitulacionAsync(id);
        await CargarDatos();
    }
}