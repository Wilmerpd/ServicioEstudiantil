@page "/horarios"
@rendermode InteractiveServer
@inject IHorarioService HorarioService
@inject IAsignaturaService AsignaturaService

<PageTitle>Horarios</PageTitle>

<div class="page-header">
    <div>
        <h1>Horarios</h1>
        <p class="page-subtitle">Bloques de clase por asignatura, día y aula.</p>
    </div>
    <button class="btn btn-primary" @onclick="AbrirModalCrear" disabled="@(!PuedeCrear)">
        <span>+</span> Nuevo horario
    </button>
</div>

<AlertBanner Mensaje="@mensajeAlerta" Tipo="@tipoAlerta" OnClose="@(() => mensajeAlerta = null)" />

@if (!PuedeCrear && asignaturas != null)
{
    <div class="empty-state">
        <p>Necesitas al menos una <strong>asignatura</strong> registrada antes de poder crear horarios.</p>
        <a class="btn btn-outline-primary" href="/asignaturas">Ir a Asignaturas</a>
    </div>
}

@if (horarios == null)
{
    <div class="loading-box"><em>Cargando horarios...</em></div>
}
else if (!horarios.Any())
{
    <div class="empty-state">
        <p>No hay horarios registrados todavía.</p>
    </div>
}
else
{
    <div class="table-card">
        <table class="table table-app">
            <thead>
                <tr>
                    <th>Día</th>
                    <th>Hora</th>
                    <th>Aula</th>
                    <th>Asignatura</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in horarios)
                {
                    <tr>
                        <td><span class="badge-dia">@h.DiaSemana</span></td>
                        <td>@FormatoHora(h.HoraInicio) - @FormatoHora(h.HoraFin)</td>
                        <td>@h.Aula</td>
                        <td>@h.NombreAsignatura</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => AbrirModalEditar(h)">Editar</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => AbrirConfirmEliminar(h)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<ModalDialog IsVisible="mostrarModal" IsVisibleChanged="@(v => mostrarModal = v)"
             Titulo="@(editando ? "Editar horario" : "Nuevo horario")" Icon="🕒">
    <ChildContent>
        <EditForm Model="formModel" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />
            <div class="form-row">
                <div class="form-group">
                    <label>Día de la semana</label>
                    <InputSelect class="form-control" @bind-Value="formModel.DiaSemana">
                        <option value="">Selecciona un día</option>
                        @foreach (var dia in dias)
                        {
                            <option value="@dia">@dia</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-group">
                    <label>Aula</label>
                    <InputText class="form-control" @bind-Value="formModel.Aula" placeholder="Ej. A-201" />
                </div>
            </div>
            <div class="form-group">
                <label>Hora de inicio</label>
                <input type="time" class="form-control" @bind="tiempoInicio" />
            </div>
            <div class="form-group">
                <label>Hora de fin</label>
                <input type="time" class="form-control" @bind="tiempoFin" />
            </div>
            <div class="form-group">
                <label>Asignatura</label>
                <InputSelect class="form-control" @bind-Value="formModel.AsignaturaId">
                    <option value="0">Selecciona una asignatura</option>
                    @if (asignaturas != null)
                    {
                        @foreach (var a in asignaturas)
                        {
                            <option value="@a.Id">@a.Nombre</option>
                        }
                    }
                </InputSelect>
            </div>
            @if (!string.IsNullOrEmpty(errorForm))
            {
                <div class="form-error">@errorForm</div>
            }
            <div class="modal-actions-inline">
                <button type="button" class="btn btn-outline-secondary" @onclick="CerrarModal">Cancelar</button>
                <button type="submit" class="btn btn-primary" disabled="@guardando">
                    @(guardando ? "Guardando..." : "Guardar")
                </button>
            </div>
        </EditForm>
    </ChildContent>
</ModalDialog>

<ConfirmDialog IsVisible="mostrarConfirm" IsVisibleChanged="@(v => mostrarConfirm = v)"
               Titulo="Eliminar horario"
               Mensaje="@($"¿Deseas eliminar el horario de '{horarioAEliminar?.NombreAsignatura}' el {horarioAEliminar?.DiaSemana}? Esta acción no se puede deshacer.")"
               OnConfirm="EliminarConfirmado" />

@code {
    private static readonly string[] dias = { "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado" };

    private List<HorarioDTO>? horarios;
    private List<AsignaturaDTO>? asignaturas;
    private HorarioInputDTO formModel = new();
    private TimeOnly? tiempoInicio;
    private TimeOnly? tiempoFin;
    private bool mostrarModal = false;
    private bool mostrarConfirm = false;
    private bool editando = false;
    private bool guardando = false;
    private int idEditando = 0;
    private HorarioDTO? horarioAEliminar;
    private string? errorForm;
    private string? mensajeAlerta;
    private string tipoAlerta = "success";

    private bool PuedeCrear => asignaturas?.Any() ?? false;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        horarios = await HorarioService.ObtenerHorariosAsync();
        asignaturas = await AsignaturaService.ObtenerAsignaturasAsync();
    }

    private string FormatoHora(TimeSpan t) => DateTime.Today.Add(t).ToString("hh:mm tt");

    private void AbrirModalCrear()
    {
        formModel = new HorarioInputDTO();
        tiempoInicio = null;
        tiempoFin = null;
        editando = false;
        errorForm = null;
        mostrarModal = true;
    }

    private void AbrirModalEditar(HorarioDTO p)
    {
        formModel = new HorarioInputDTO
            {
                Id = p.Id,
                DiaSemana = p.DiaSemana,
                HoraInicio = p.HoraInicio,
                HoraFin = p.HoraFin,
                Aula = p.Aula
            };
        editando = true;
        errorForm = null;
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private void AbrirConfirmEliminar(HorarioDTO h)
    {
        horarioAEliminar = h;
        mostrarConfirm = true;
    }

    private async Task Guardar()
    {
       
        if (tiempoInicio.HasValue)
        {
            formModel.HoraInicio = tiempoInicio.Value.ToTimeSpan();
        }

        if (tiempoFin.HasValue)
        {
            formModel.HoraFin = tiempoFin.Value.ToTimeSpan();
        }

        if (tiempoFin <= tiempoInicio)
        {
            errorForm = "La hora de fin debe ser mayor a la hora de inicio.";
            return;
        }

        guardando = true;
        errorForm = null;
        bool exito;

        if (editando)
        {
            exito = await HorarioService.ActualizarHorarioAsync(formModel);
        }
        else
        {
            exito = await HorarioService.CrearHorarioAsync(formModel);
        }

        guardando = false;

        if (exito)
        {
            mostrarModal = false;
            mensajeAlerta = editando ? "Horario actualizado correctamente." : "Horario creado correctamente.";
            tipoAlerta = "success";
            await CargarDatos();
        }
        else
        {
            errorForm = "Ocurrió un error al guardar. Verifica los datos e intenta de nuevo.";
        }
    }

    private async Task EliminarConfirmado()
    {
        if (horarioAEliminar == null) return;

        var exito = await HorarioService.EliminarHorarioAsync(horarioAEliminar.Id);
        mensajeAlerta = exito ? "Horario eliminado." : "No se pudo eliminar el horario.";
        tipoAlerta = exito ? "success" : "danger";

        if (exito)
        {
            await CargarDatos();
        }
    }
}
