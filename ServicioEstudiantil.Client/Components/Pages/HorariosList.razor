@page "/horarios"
@rendermode InteractiveServer
@inject IHorarioService HorarioService
@inject IAsignaturaService AsignaturaService
@using ServicioEstudiantil.Client.Contracts
@using ServicioEstudiantil.Core.DTOs

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3>Horarios</h3>
        <p class="text-muted">Bloques de clase por asignatura, día y aula.</p>
    </div>
</div>

<div class="card mb-4 p-3 shadow-sm">
    <h5>@(editandoId == 0 ? "Nuevo Horario" : "Editar Horario")</h5>
    <div class="row g-3">
        <div class="col-md-2">
            <label class="form-label">Día</label>
            <select class="form-select" @bind="nuevoDiaSemana">
                <option value="Lunes">Lunes</option>
                <option value="Martes">Martes</option>
                <option value="Miércoles">Miércoles</option>
                <option value="Jueves">Jueves</option>
                <option value="Viernes">Viernes</option>
                <option value="Sábado">Sábado</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Hora Inicio</label>
            <input type="time" class="form-control" @bind="nuevaHoraInicio" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Hora Fin</label>
            <input type="time" class="form-control" @bind="nuevaHoraFin" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Aula</label>
            <input class="form-control" placeholder="Ej: A-104" @bind="nuevaAula" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Asignatura</label>
            <select class="form-select" @bind="asignaturaIdSeleccionada">
                <option value="0">Seleccione...</option>
                @if (asignaturas != null)
                {
                    @foreach (var asig in asignaturas)
                    {
                        <option value="@asig.Id">@asig.Nombre</option>
                    }
                }
            </select>
        </div>
        <div class="col-12 text-end mt-3">
            <button class="btn btn-primary" @onclick="Guardar">
                @(editandoId == 0 ? "+ Agregar Horario" : "Guardar Cambios")
            </button>
        </div>
    </div>
</div>

@if (horarios != null)
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">DÍA</th>
                        <th>HORARIO</th>
                        <th>AULA</th>
                        <th>ASIGNATURA</th>
                        <th class="text-end pe-4">ACCIONES</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in horarios)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="badge bg-warning bg-opacity-25 text-dark px-2 py-1">@h.DiaSemana</span>
                            </td>
                            <td>@h.HoraInicio.ToString(@"hh\:mm") - @h.HoraFin.ToString(@"hh\:mm")</td>
                            <td>@h.Aula</td>
                            <td>@h.NombreAsignatura</td>
                            <td class="text-end pe-4">
                                <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => PrepararEdicion(h)">Editar</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(h.Id)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<HorarioDTO>? horarios;
    private List<AsignaturaDTO>? asignaturas;
    private int editandoId = 0;

    private string nuevoDiaSemana = "Lunes";
    private DateTime nuevaHoraInicio = DateTime.Today.AddHours(18); // 6:00 PM por defecto
    private DateTime nuevaHoraFin = DateTime.Today.AddHours(20);    // 8:00 PM por defecto
    private string nuevaAula = string.Empty;
    private int asignaturaIdSeleccionada = 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
        asignaturas = await AsignaturaService.ObtenerAsignaturasAsync();
    }

    private async Task CargarDatos()
    {
        horarios = await HorarioService.ObtenerHorariosAsync();
    }

    private async Task Guardar()
    {
        if (asignaturaIdSeleccionada == 0) return;

        var inputDto = new HorarioInputDTO
            {
                Id = editandoId,
                DiaSemana = nuevoDiaSemana,
                HoraInicio = nuevaHoraInicio.TimeOfDay, // <-- Aquí sacamos el TimeSpan
                HoraFin = nuevaHoraFin.TimeOfDay,       // <-- Aquí sacamos el TimeSpan
                Aula = nuevaAula,
                AsignaturaId = asignaturaIdSeleccionada
            };

        bool exito;
        if (editandoId == 0)
        {
            exito = await HorarioService.CrearHorarioAsync(inputDto);
        }
        else
        {
            exito = await HorarioService.ActualizarHorarioAsync(inputDto);
        }

        if (exito)
        {
            LimpiarFormulario();
            await CargarDatos();
        }
    }

    private void PrepararEdicion(HorarioDTO h)
    {
        editandoId = h.Id;
        nuevoDiaSemana = h.DiaSemana;
        nuevaHoraInicio = DateTime.Today.Add(h.HoraInicio);
        nuevaHoraFin = DateTime.Today.Add(h.HoraFin);
        nuevaAula = h.Aula;


        // Como el HorarioDTO solo trae el Nombre de la asignatura, buscamos su ID en la lista local para seleccionarla
        var asignaturaVinculada = asignaturas?.FirstOrDefault(a => a.Nombre == h.NombreAsignatura);
        asignaturaIdSeleccionada = asignaturaVinculada != null ? asignaturaVinculada.Id : 0;
    }

    private async Task Eliminar(int id)
    {
        await HorarioService.EliminarHorarioAsync(id);
        await CargarDatos();
    }

    private void LimpiarFormulario()
    {
        editandoId = 0;
        nuevoDiaSemana = "Lunes";
        nuevaHoraInicio = DateTime.Today.AddHours(18);
        nuevaHoraFin = DateTime.Today.AddHours(20);
        nuevaAula = "";
        asignaturaIdSeleccionada = 0;
    }
}